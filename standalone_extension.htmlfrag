<script>
/* Study Historia standalone extension: all state remains local to this browser. */
(()=>{
  const STORE='study-historia-standalone-v1';
  const $=(s,r=document)=>r.querySelector(s);
  const esc=v=>String(v??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
  const uid=()=>crypto.randomUUID?.()||`standalone-${Date.now()}-${Math.random().toString(16).slice(2)}`;
  const day=()=>new Date().toISOString().slice(0,10);
  const norm=v=>String(v??'').trim().toLocaleLowerCase('vi').replace(/\s+/g,' ');
  const read=()=>{try{return JSON.parse(localStorage.getItem(STORE)||'{}')}catch{return {}}};
  const write=s=>localStorage.setItem(STORE,JSON.stringify(s));
  const active=()=>{const s=read();return [s,s.active&&s.profiles?.[s.active],s.accounts?.find(a=>a.id===s.active)]};
  const profile=()=>{const [s,p]=active();if(!p)return null;p.aiImportHistory=Array.isArray(p.aiImportHistory)?p.aiImportHistory:[];p.advancedQuizzes=Array.isArray(p.advancedQuizzes)?p.advancedQuizzes:[];return p};
  const saveProfile=()=>{const [s,p]=active();if(p)write(s)};
  const note=(text,kind='')=>{let t=$('#toast');if(!t){t=document.createElement('div');t.id='toast';t.className='toast';t.setAttribute('role','status');t.setAttribute('aria-live','polite');document.body.append(t)}t.textContent=text;t.className=`toast ${kind}`;t.classList.remove('hidden');clearTimeout(note.t);note.t=setTimeout(()=>t.classList.add('hidden'),3400)};
  const close=()=>$('#standalone-modal')?.remove();
  const modal=(title,body)=>{close();const box=document.createElement('section');box.id='standalone-modal';box.className='modal';box.setAttribute('role','dialog');box.setAttribute('aria-modal','true');box.setAttribute('aria-label',title);box.innerHTML=`<div class="panel standalone-modal-box"><div class="section-head"><div><span class="eyebrow">STUDY HISTORIA · LOCAL</span><h2>${esc(title)}</h2></div><button class="icon" data-standalone="close" aria-label="Đóng">Đóng</button></div>${body}`;document.body.append(box);box.querySelector('button')?.focus()};
  const addActivity=(kind,amount=1,seconds=0)=>{const p=profile();if(!p)return;p.activity=Array.isArray(p.activity)?p.activity:[];p.activity.push({id:uid(),date:day(),kind,amount,seconds});p.activity=p.activity.slice(-1500)};
  const award=(xp=0,fragments=0)=>{const p=profile();if(!p)return;p.xp=(p.xp||0)+xp;p.fragments=(p.fragments||0)+fragments;p.level=Math.max(1,Math.floor((p.xp||0)/120)+1)};
  const stat=()=>{const p=profile();if(!p)return {sets:0,cards:0,attempts:0,xp:0,streak:0};const acts=p.activity||[];const unique=[...new Set(acts.map(a=>a.date))].sort().reverse();let streak=0,d=new Date();while(unique.includes(d.toISOString().slice(0,10))){streak++;d.setDate(d.getDate()-1)}return {sets:(p.sets||[]).length,cards:(p.sets||[]).reduce((n,s)=>n+(s.cards||[]).length,0),attempts:(p.attempts||[]).length,xp:p.xp||0,fragments:p.fragments||0,streak};};
  const addNav=()=>{const nav=$('.nav');if(!nav||nav.dataset.standaloneReady)return;nav.dataset.standaloneReady='1';const nodes=[['focus','Ôn tập thông minh'],['pomodoro','Pomodoro'],['knowledge','Bản đồ kiến thức'],['ai-import-modal','AI Data Import'],['study-history','Lịch sử học']];nodes.forEach(([key,label])=>{const b=document.createElement('button');b.type='button';b.dataset.standalone=key;b.textContent=label;nav.insertBefore(b,nav.querySelector('[data-view="account"]')||null)});};
  new MutationObserver(addNav).observe(document.documentElement,{childList:true,subtree:true});document.addEventListener('DOMContentLoaded',addNav);setTimeout(addNav,50);

  function focusHub(){const z=stat(),p=profile(),last=(p?.attempts||[]).at(-1),weak=last?.questions?.filter((q,i)=>last.answers?.[i]!==q.answer).length||0;modal('Ôn tập thông minh',`<div class="cards"><article class="panel card"><span class="tag">Ôn lại những phần chưa chắc</span><h3>${weak||'0'} câu cần xem lại</h3><p>Dựa trên câu sai của lần làm đề gần nhất. Khi chưa có dữ liệu, hãy làm một đề hoặc tạo Flashcard trước.</p><button class="secondary" data-standalone="open-quiz">Mở Đề kiểm tra</button></article><article class="panel card"><span class="tag">Chuỗi học tích cực</span><h3>${z.streak} ngày liên tiếp</h3><p>Một phiên ngắn cũng được tính. Không có thông điệp phạt khi bạn quay lại học.</p></article><article class="panel card"><span class="tag">Kho mảnh ghép</span><h3>${z.fragments} mảnh đang có</h3><p>Mở Bảo tàng để dùng mảnh ghép và theo dõi nhân vật gần hoàn thành.</p><button class="secondary" data-standalone="open-museum">Mở Bảo tàng</button></article></div><section class="panel editor section"><span class="eyebrow">HỌC 10 PHÚT</span><h3>Mini-session bốn chặng</h3><p class="muted">Đọc Flashcard · Trắc nghiệm · Đúng/Sai · Trả lời ngắn. Hoàn tất sẽ cộng 20 XP và ghi hoạt động học vào localStorage.</p><ol><li>Chọn một bộ Flashcard.</li><li>Trả lời một câu trắc nghiệm.</li><li>Xác định một mệnh đề đúng/sai.</li><li>Viết lại đáp án theo ý hiểu của bạn.</li></ol><button class="primary" data-standalone="complete-ten">Hoàn tất Học 10 phút</button></section>`)}
  function pomodoro(){const saved=JSON.parse(localStorage.getItem('study-historia-pomodoro')||'{"focus":25,"break":5,"sound":true,"auto":false}');modal('Pomodoro học lịch sử',`<div class="split"><section class="panel editor"><span class="eyebrow">PHIÊN TẬP TRUNG</span><div class="pomodoro-clock" id="pomo-clock">${String(saved.focus).padStart(2,'0')}:00</div><p id="pomo-state" class="muted">Sẵn sàng bắt đầu phiên học.</p><div class="row"><button class="primary" data-standalone="pomo-start">Bắt đầu</button><button class="secondary" data-standalone="pomo-reset">Đặt lại</button></div></section><section class="panel editor"><h3>Cấu hình yêu thích</h3><label class="field">Tập trung (phút)<input id="pomo-focus" type="number" min="1" max="120" value="${saved.focus}"></label><label class="field">Nghỉ (phút)<input id="pomo-break" type="number" min="1" max="60" value="${saved.break}"></label><label class="field"><span><input id="pomo-auto" type="checkbox" ${saved.auto?'checked':''}> Tự chuyển phiên</span></label><label class="field"><span><input id="pomo-sound" type="checkbox" ${saved.sound?'checked':''}> Âm báo kết thúc</span></label><button class="secondary" data-standalone="pomo-save">Lưu cấu hình</button><p class="help">Preset gợi ý: 25/5, 40/10 hoặc tự tùy chỉnh. Đồng hồ tiếp tục trong khi modal mở.</p></section></div>`)}
  let pomoTimer=null,pomoLeft=0,pomoKind='focus';
  const clock=()=>{const n=$('#pomo-clock');if(n)n.textContent=`${String(Math.floor(pomoLeft/60)).padStart(2,'0')}:${String(pomoLeft%60).padStart(2,'0')}`};
  const pomoConfig=()=>({focus:Math.max(1,Number($('#pomo-focus')?.value||25)),break:Math.max(1,Number($('#pomo-break')?.value||5)),auto:!!$('#pomo-auto')?.checked,sound:!!$('#pomo-sound')?.checked});
  function knowledge(){const p=profile(),sets=p?.sets||[],subjects=[...new Set(sets.map(s=>s.subject||'Chưa phân loại'))];const cards=subjects.map(subject=>{const mine=sets.filter(s=>(s.subject||'Chưa phân loại')===subject),total=mine.reduce((n,s)=>n+(s.cards||[]).length,0),learned=mine.reduce((n,s)=>n+(s.learned||0),0),ratio=total?Math.round(learned/total*100):0,status=!total?'Chưa học':ratio>=70?'Chắc':ratio>=35?'Cần ôn':'Chưa chắc';return `<article class="panel card"><span class="tag">${esc(status)}</span><h3>${esc(subject)}</h3><p>${learned}/${total} thẻ đã học · ${ratio}% tiến trình</p><div class="bar"><i style="width:${ratio}%"></i></div><button class="secondary" data-standalone="open-library">Học Flashcard</button></article>`}).join('')||'<div class="empty">Chưa có chủ đề. Hãy tạo bộ thẻ hoặc nhập dữ liệu AI để bản đồ hình thành.</div>';modal('Bản đồ kiến thức',`<p class="muted">Trạng thái được tính từ dữ liệu học đã lưu, không tạo dữ liệu minh họa.</p><div class="cards">${cards}</div>`)}
  function history(){const p=profile(),sets=p?.sets||[],attempts=p?.attempts||[];const bySet=sets.map(s=>{const a=attempts.filter(x=>x.quizId===s.id),avg=a.length?Math.round(a.reduce((n,x)=>n+(x.score||0),0)/a.length):0,best=a.length?Math.max(...a.map(x=>x.score||0)):0;return `<article class="list-item"><strong>${esc(s.title)}</strong><small>${esc(s.subject||'Chưa phân loại')} · ${(s.cards||[]).length} Flashcard · ${a.length} lượt làm đề · cao nhất ${best}% · trung bình ${avg}%</small></article>`}).join('')||'<div class="empty">Chưa có lịch sử học. Tạo bộ thẻ hoặc làm đề để xem số liệu ở đây.</div>';modal('Lịch sử học',`<section class="panel editor"><p class="muted">Tổng hợp theo bộ/tài liệu đang lưu trong hồ sơ trình duyệt này.</p><div class="list">${bySet}</div></section>`)}
  function aiPrompt(){const target=$('#ai-target')?.value||'both',source=$('#ai-source')?.value||'tài liệu học',types=[...document.querySelectorAll('[name="ai-type"]:checked')].map(x=>x.value).join(', ')||'trắc nghiệm',count=$('#ai-count')?.value||'auto';return `Bạn là chuyên gia chuẩn hóa học liệu. Hãy đọc ${source} và chỉ xuất DỮ LIỆU JSON, không giải thích ngoài JSON. Mục tiêu: ${target==='both'?'Quiz và Flashcard':target==='quiz'?'Quiz':'Flashcard'}. Loại câu: ${types}. Số lượng: ${count}. Giữ nguyên đáp án đúng theo nguồn; nếu nguồn mâu thuẫn, đưa warning vào trường sourceWarning. Dùng schema: {"title":"...","subject":"...","items":[{"type":"multiple_choice|true_false|short_answer","question":"...","options":["..."],"answer":"...","explanation":"...","source":"..."}]}. Với true_false, options phải là ["Đúng","Sai"]. Với short_answer, options là []. Không bịa dữ kiện hoặc nguồn.`}
  function parseItems(raw){let data;try{data=JSON.parse(raw)}catch{data=null}if(data){const arr=Array.isArray(data)?data:(data.items||data.questions||data.cards||[]);return {title:data.title||'Nhập từ AI',subject:data.subject||'AI Data Import',items:arr.map(x=>({type:x.type||((x.front||x.back)?'flashcard':'multiple_choice'),question:String(x.question||x.text||x.front||''),options:Array.isArray(x.options)?x.options.map(String):[],answer:String(x.answer??x.back??''),explanation:String(x.explanation||x.note||''),source:String(x.source||'')}))}}const blocks=raw.split(/\[QUESTION\]/i).slice(1).map(x=>x.split(/\[\/QUESTION\]/i)[0]);const items=blocks.map(b=>{const pick=k=>{const m=b.match(new RegExp(`^${k}\\s*:\\s*(.*)$`,'im'));return m?m[1].trim():''};const options=(b.match(/^\s*[A-D][.)]\s*(.+)$/gim)||[]).map(x=>x.replace(/^\s*[A-D][.)]\s*/i,'').trim());return {type:pick('type')||'multiple_choice',question:pick('question'),options,answer:pick('answer').replace(/^[A-D][.)]\s*/i,''),explanation:pick('explanation'),source:pick('source')}});return {title:'Nhập QUESTION',subject:'AI Data Import',items}}
  function validate(parsed){const errors=[],warnings=[],seen=new Set();parsed.items.forEach((q,i)=>{const at=`Mục ${i+1}`;q.type=String(q.type||'multiple_choice').toLowerCase();if(['mcq','multiple choice','multiple-choice'].includes(q.type))q.type='multiple_choice';if(['truefalse','true false','đúng/sai'].includes(q.type))q.type='true_false';if(['short','short answer','trả lời ngắn'].includes(q.type))q.type='short_answer';if(!q.question.trim())errors.push(`${at}: thiếu câu hỏi.`);if(!['multiple_choice','true_false','short_answer','flashcard'].includes(q.type))errors.push(`${at}: loại câu không hợp lệ.`);if(['multiple_choice','true_false'].includes(q.type)&&q.options.length<2)errors.push(`${at}: cần ít nhất 2 lựa chọn.`);if(!q.answer.trim())errors.push(`${at}: thiếu đáp án.`);if(q.type==='multiple_choice'&&q.answer&& !q.options.some(o=>norm(o)===norm(q.answer))){const n=Number(q.answer);if(Number.isInteger(n)&&q.options[n])q.answer=q.options[n];else errors.push(`${at}: đáp án không thuộc lựa chọn.`)}if(q.type==='true_false'){q.options=['Đúng','Sai'];if(!['đúng','sai','true','false'].includes(norm(q.answer)))errors.push(`${at}: đáp án đúng/sai không hợp lệ.`);else q.answer=['true','đúng'].includes(norm(q.answer))?'Đúng':'Sai'}const key=norm(q.question);if(key&&seen.has(key))errors.push(`${at}: câu hỏi trùng lặp.`);seen.add(key);if(!q.explanation)warnings.push(`${at}: chưa có giải thích.`);if(!q.source)warnings.push(`${at}: chưa có nguồn.`)});return {errors,warnings,parsed}}
  function previewAI(){const raw=$('#ai-raw')?.value||'',out=$('#ai-preview');if(!raw.trim()){out.innerHTML='<p class="help">Dán JSON hoặc khối [QUESTION] để kiểm tra dữ liệu.</p>';return}const v=validate(parseItems(raw)),dist={multiple_choice:0,true_false:0,short_answer:0,flashcard:0};v.parsed.items.forEach(x=>dist[x.type]=(dist[x.type]||0)+1);out.dataset.payload=JSON.stringify(v.parsed);out.innerHTML=`<div class="list-item"><strong>${v.parsed.items.length} mục đã đọc</strong><small>Trắc nghiệm ${dist.multiple_choice||0} · Đúng/Sai ${dist.true_false||0} · Trả lời ngắn ${dist.short_answer||0} · Flashcard ${dist.flashcard||0}</small></div>${v.errors.length?`<div class="list-item" style="border-color:var(--danger)"><strong>Lỗi (${v.errors.length})</strong><small>${v.errors.map(esc).join('<br>')}</small></div>`:''}${v.warnings.length?`<div class="list-item"><strong>Cảnh báo (${v.warnings.length})</strong><small>${v.warnings.map(esc).join('<br>')}</small></div>`:''}<div class="row"><button class="primary" data-standalone="ai-import" ${v.errors.length?'disabled':''}>Tạo nội dung từ dữ liệu hợp lệ</button></div>`}
  function aiImport(){const pre=$('#ai-preview');if(!pre?.dataset.payload)return note('Hãy kiểm tra dữ liệu trước.','bad');const parsed=JSON.parse(pre.dataset.payload),v=validate(parsed);if(v.errors.length)return note('Cần sửa lỗi dữ liệu trước khi tạo.','bad');const p=profile(),target=$('#ai-target').value,items=parsed.items.slice(0,27),cards=items.map(q=>({front:q.question,back:q.answer,note:q.explanation,source:q.source})).filter(c=>c.front&&c.back);const qitems=items.filter(q=>['multiple_choice','true_false','short_answer'].includes(q.type));const set={id:uid(),title:parsed.title||'Nhập từ AI',subject:parsed.subject||'AI Data Import',cards:target==='quiz'?[]:cards,learned:0,createdAt:new Date().toISOString()};if(target!=='flashcard'&&qitems.length){set.quiz={title:`${set.title} · Đề kiểm tra`,minutes:Math.max(5,Math.ceil(qitems.length*1.3)),questions:qitems.filter(q=>q.type!=='short_answer').map(q=>({text:q.question,options:q.options,answer:q.options.findIndex(o=>norm(o)===norm(q.answer)),explanation:q.explanation}))};p.advancedQuizzes.push({id:set.id,title:set.quiz.title,subject:set.subject,questions:qitems,createdAt:new Date().toISOString()})}if(!set.cards.length&&!qitems.length)return note('Không có nội dung phù hợp để tạo.','bad');p.sets.push(set);p.aiImportHistory.unshift({id:uid(),date:new Date().toISOString(),title:set.title,target,questionCount:qitems.length,cardCount:cards.length,prompt:$('#ai-prompt').value,raw:$('#ai-raw').value,setId:set.id});p.aiImportHistory=p.aiImportHistory.slice(0,60);addActivity('ai-import',items.length);award(Math.max(5,items.length),0);saveProfile();note(`Đã tạo ${set.cards.length} Flashcard và ${qitems.length} câu hỏi.`, 'good');close();}
  function aiImportModal(){const p=profile(),history=(p?.aiImportHistory||[]).slice(0,8).map(h=>`<article class="list-item"><strong>${esc(h.title)}</strong><small>${new Date(h.date).toLocaleString('vi-VN')} · ${h.target} · ${h.cardCount} thẻ · ${h.questionCount} câu</small><div class="list-actions"><button class="secondary" data-standalone="ai-reload" data-id="${h.id}">Nạp lại</button><button class="danger" data-standalone="ai-delete" data-id="${h.id}">Xóa</button></div></article>`).join('')||'<div class="empty">Chưa có lịch sử nhập AI trong trình duyệt này.</div>';modal('AI Data Import',`<p class="muted">AI bên ngoài đọc tài liệu. Website này chỉ tạo prompt, tiếp nhận dữ liệu chuẩn, kiểm tra và chuyển thành học liệu. Không có tệp nào được tự gửi ra ngoài.</p><div class="split"><section class="panel editor"><h3>1. Tạo prompt cho AI bên ngoài</h3><label class="field">Loại nguồn<select id="ai-source"><option>Tài liệu PDF/Word/Excel</option><option>Ảnh chụp/screenshot</option><option>Đề kiểm tra cũ</option><option>Nội dung bài học</option></select></label><label class="field">Mục tiêu<select id="ai-target"><option value="both">Đề + Flashcard</option><option value="quiz">Đề kiểm tra</option><option value="flashcard">Flashcard</option></select></label><div class="field"><span>Loại câu</span><label><input type="checkbox" name="ai-type" value="trắc nghiệm" checked> Trắc nghiệm</label><label><input type="checkbox" name="ai-type" value="đúng/sai"> Đúng/Sai</label><label><input type="checkbox" name="ai-type" value="trả lời ngắn"> Trả lời ngắn</label></div><label class="field">Số lượng<select id="ai-count"><option value="auto">Tự động</option><option>10</option><option>20</option><option>30</option></select></label><button class="secondary" data-standalone="prompt-build">Tạo lại prompt</button><label class="field">Prompt để sao chép<textarea id="ai-prompt" readonly>${esc(aiPrompt())}</textarea></label><button class="primary" data-standalone="prompt-copy">Sao chép prompt</button></section><section class="panel editor"><h3>2. Dán dữ liệu AI đã trả về</h3><label class="field">JSON hoặc khối [QUESTION]<textarea id="ai-raw" placeholder='{"title":"...","items":[...]}'></textarea></label><button class="secondary" data-standalone="ai-preview">Kiểm tra và xem trước</button><div id="ai-preview" class="stack" style="margin-top:1rem"><p class="help">Không dùng dữ liệu mẫu. Dán nội dung AI bên ngoài trả về để bắt đầu.</p></div></section></div><section class="section"><div class="section-head"><div><span class="eyebrow">LỊCH SỬ NHẬP AI</span><h2>Đã lưu trong hồ sơ này</h2></div></div><div class="list">${history}</div></section>`)}
  function copyText(text){navigator.clipboard?.writeText(text).then(()=>note('Đã sao chép.','good')).catch(()=>{const t=document.createElement('textarea');t.value=text;document.body.append(t);t.select();document.execCommand('copy');t.remove();note('Đã sao chép.','good')})}
  function openBuiltIn(view){close();const b=document.querySelector(`[data-view="${view}"]`);if(b)b.click();else note('View chưa sẵn sàng.','bad')}
  function runAdvanced(id){const p=profile(),quiz=p?.advancedQuizzes?.find(q=>q.id===id);if(!quiz)return note('Không tìm thấy đề.','bad');let i=0,answers={},start=Date.now();const draw=()=>{const q=quiz.questions[i],options=q.type==='short_answer'?`<label class="field">Câu trả lời<input id="advanced-answer" autocomplete="off"></label>`:q.options.map((o,j)=>`<button class="answer" data-standalone="advanced-answer" data-value="${esc(o)}">${esc(o)}</button>`).join('');modal(quiz.title,`<section class="panel quiz-q"><span class="eyebrow">CÂU ${i+1}/${quiz.questions.length} · ${esc(q.type)}</span><h3>${esc(q.question)}</h3><div class="answers">${options}</div>${q.type==='short_answer'?'<button class="primary" data-standalone="advanced-submit">Xác nhận</button>':''}<p class="help">Dữ liệu và kết quả được lưu cục bộ trong hồ sơ này.</p></section>`)};window.__advanced={answer:v=>{answers[i]=v;if(i<quiz.questions.length-1){i++;draw()}else{const correct=quiz.questions.reduce((n,q,k)=>n+(norm(answers[k])===norm(q.answer)),0),result={id:uid(),quizId:id,title:quiz.title,completedAt:new Date().toISOString(),correct,total:quiz.questions.length,skipped:0,answers,questions:quiz.questions,score:Math.round(correct/quiz.questions.length*100),seconds:Math.floor((Date.now()-start)/1000)};p.attempts.push(result);addActivity('quiz',result.total,result.seconds);award(correct*5,correct?1:0);saveProfile();modal('Kết quả đề kiểm tra',`<section class="panel editor"><h3>${correct}/${result.total} câu đúng · ${result.score}%</h3><p class="muted">Kết quả đã lưu vào lịch sử. Bạn có thể mở Đề kiểm tra hoặc Lịch sử học để ôn lại.</p><button class="primary" data-standalone="close">Hoàn tất</button></section>`)}}};draw()}
  document.addEventListener('click',e=>{const b=e.target.closest('[data-standalone]');if(!b)return;const action=b.dataset.standalone; if(action==='close')return close();if(action==='focus')return focusHub();if(action==='pomodoro')return pomodoro();if(action==='knowledge')return knowledge();if(action==='ai-import-modal')return aiImportModal();if(action==='ai-import')return aiImport();if(action==='study-history')return history();if(action==='open-quiz')return openBuiltIn('quiz');if(action==='open-library')return openBuiltIn('library');if(action==='open-museum')return openBuiltIn('museum');if(action==='complete-ten'){addActivity('mini-session',1,600);award(20,1);saveProfile();note('Đã ghi nhận Học 10 phút: +20 XP, +1 mảnh ghép.','good');return focusHub()}if(action==='pomo-save'){localStorage.setItem('study-historia-pomodoro',JSON.stringify(pomoConfig()));note('Đã lưu cấu hình Pomodoro.','good');return}if(action==='pomo-reset'){clearInterval(pomoTimer);pomoLeft=pomoConfig().focus*60;pomoKind='focus';clock();return}if(action==='pomo-start'){if(pomoTimer)return;const c=pomoConfig();if(!pomoLeft)pomoLeft=c.focus*60;$('#pomo-state').textContent=pomoKind==='focus'?'Đang tập trung…':'Đang nghỉ…';pomoTimer=setInterval(()=>{pomoLeft--;clock();if(pomoLeft<=0){clearInterval(pomoTimer);pomoTimer=null;if(c.sound)note('Hết phiên '+(pomoKind==='focus'?'tập trung':'nghỉ')+'.','good');if(pomoKind==='focus'){addActivity('pomodoro',1,c.focus*60);award(5,0);saveProfile()}pomoKind=pomoKind==='focus'?'break':'focus';pomoLeft=(pomoKind==='focus'?c.focus:c.break)*60;clock();if(c.auto)b.click()}},1000);return}if(action==='prompt-build'){const t=$('#ai-prompt');t.value=aiPrompt();return}if(action==='prompt-copy')return copyText($('#ai-prompt').value);if(action==='ai-preview')return previewAI();if(action==='ai-reload'){const h=profile()?.aiImportHistory?.find(x=>x.id===b.dataset.id);if(!h)return;aiImportModal();setTimeout(()=>{$('#ai-raw').value=h.raw||'';$('#ai-prompt').value=h.prompt||$('#ai-prompt').value;previewAI()},0);return}if(action==='ai-delete'){const p=profile();p.aiImportHistory=p.aiImportHistory.filter(x=>x.id!==b.dataset.id);saveProfile();return aiImportModal()}if(action==='advanced-answer')return window.__advanced?.answer(b.dataset.value);if(action==='advanced-submit')return window.__advanced?.answer($('#advanced-answer')?.value||'');});
  document.addEventListener('click',e=>{const b=e.target.closest('[data-run-advanced]');if(b)runAdvanced(b.dataset.runAdvanced)});
})();
</script>
